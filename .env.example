# Copy this file to ".env" and fill in your real values.
# `bot.py` auto-loads ".env" at startup if python-dotenv is installed
# (it is, via requirements.txt). On Railway, paste these same names/values
# into the project's *Variables* tab instead of committing a .env file.

# REQUIRED -------------------------------------------------------------------

# Token from @BotFather. Run /newbot to get one, or /revoke -> /token to
# rotate an existing one. Never paste this anywhere public.
BOT_TOKEN=123456:abcdef-replace-with-your-real-token

# Comma-separated Telegram numeric user IDs allowed to use the bot.
# To find your own ID, message @userinfobot once.
ADMIN_IDS=5376199311

# OPTIONAL -------------------------------------------------------------------

# Parallel range-split download workers (default 4). Set to 1 to force a
# single-stream download.
# WORKERS=4

# Max bytes the bot will upload back as a result. Standard Telegram Bot API
# is 50 MiB; raise this only if you run a self-hosted Bot API server.
# DOC_UPLOAD_LIMIT=52428800
