# Copy this file to .env (which is gitignored) and fill in real values.
# In Railway, paste the same names/values into the project's *Variables* tab
# instead of uploading a .env file.

# Required: Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Required: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone (not recommended).
ADMIN_IDS=5376199311

# Optional: maximum size in bytes for the result zip the bot will try to
# upload. Default is the standard Telegram bot limit (50 MB).
# DOC_UPLOAD_LIMIT=52428800
