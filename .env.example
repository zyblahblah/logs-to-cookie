# Copy to .env (gitignored) and fill in real values, or set these
# variables directly in your hosting provider (Railway, Fly, etc.).

# Required: Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty / unset to allow everyone.
ADMIN_IDS=

# Optional: maximum size in bytes for the result zip the bot will try
# to upload. Default = Telegram bot upload limit (50 MB). Result
# archives larger than this make the bot stop with a clear error
# message asking the user to re-run with a stricter keyword filter.
DOC_UPLOAD_LIMIT=52428800

# Optional: max bytes the bot will accept for the input download.
# Defaults to 50 GB. Increase / decrease to taste — the bot will
# refuse any link whose Content-Length exceeds this and surface a
# friendly error suggesting the user re-run if the cap is too low.
MAX_DOWNLOAD_BYTES=1003687091200

# Optional: maximum number of URLs the bot will accept in a single
# /start job. Defaults to 10. Lower this if you want to keep job
# durations bounded; raise it for power users.
MAX_LINKS_PER_JOB=10

# Optional: maximum number of jobs that can run concurrently across
# all users. Defaults to 1 (FIFO queue). Raise this only if your host
# has the bandwidth + RAM to handle several multi-GB downloads in
# parallel.
MAX_CONCURRENT_JOBS=1

# Optional: where the bot persists its access state (VIP allow-list +
# redemption keys). Default: state.json in the working directory.
# On Railway, mount a Volume and point this at a path inside it so the
# state survives redeploys.
STATE_PATH=state.json

# Optional: root directory for per-job temp work (downloads, extracted
# archives, intermediate cookie files). Default unset → the bot uses
# the OS tempdir (``/tmp`` on Linux), which on Railway is **ephemeral**
# — a container restart wipes any in-flight download and the user has
# to start over from byte 0. To make jobs survive restarts:
#   1. Mount a Railway Volume at, say, ``/data``.
#   2. Set ``LOGS_TO_COOKIE_WORKDIR=/data`` here.
# The bot will then build a deterministic per-job path (hash of the
# user id + URLs + password + keywords) under ``/data/jobs/...`` so
# re-submitting the same URLs after a restart picks up the existing
# partial file. Combined with the resumable HTTP download in
# pipeline/download.py, a 60 GB job that died at byte 57 GB resumes
# from 57 GB instead of starting over.
# LOGS_TO_COOKIE_WORKDIR=/data

# Optional: how many times the resumable HTTP download reconnects
# after a transient stream failure (IncompleteRead /
# ChunkedEncodingError / connection drop) before giving up. Each
# retry waits ``min(60, 2 * 2 ** (attempt-1))`` seconds by default.
# Default: 10. Bump higher if your upstream CDN is exceptionally
# flaky; lower if you want errors to surface faster.
DOWNLOAD_MAX_ATTEMPTS=10
# Optional: base delay (seconds) for the exponential backoff between
# reconnect attempts. Real delay is
# ``min(DOWNLOAD_RETRY_BACKOFF_CAP, DOWNLOAD_RETRY_BASE_DELAY * 2 ** (attempt-1))``.
DOWNLOAD_RETRY_BASE_DELAY=2.0
DOWNLOAD_RETRY_BACKOFF_CAP=60.0

# Optional: minimum interval (seconds) between status-message edits
# during a job. Telegram throttles ``editMessageText`` at roughly
# 1/sec per chat — values below 1.0 will hit RetryAfter responses
# and visibly stall the progress bar. Default: 1.2.
EDIT_MIN_INTERVAL=1.2
