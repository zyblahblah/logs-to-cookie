# Copy to .env (gitignored) and fill in real values, or set these
# variables directly in your hosting provider (Railway, Fly, etc.).

# Required: Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty / unset to allow everyone.
ADMIN_IDS=

# Optional: maximum size in bytes for the result zip the bot will try
# to upload directly. Default = Telegram bot upload limit (50 MB).
# Result archives larger than this are hosted via the built-in HTTP
# server and a direct download link is sent instead.
DOC_UPLOAD_LIMIT=52428800

# Optional: max bytes the bot will accept for the input download.
# Defaults to 5 GB. Increase / decrease to taste.
MAX_DOWNLOAD_BYTES=5368709120

# Optional: built-in webserver settings (used to serve oversized
# results to the user). Leave PUBLIC_BASE_URL empty to auto-build it
# from the host the server binds to (works locally; on Railway etc.
# set it to the public URL of your service).
WEBSERVER_HOST=0.0.0.0
WEBSERVER_PORT=8080
PUBLIC_BASE_URL=

# Optional: how long (in seconds) to keep result files reachable on
# the built-in HTTP server before they're deleted. Default = 1 hour.
RESULT_TTL_SECONDS=3600
