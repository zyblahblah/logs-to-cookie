{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install-7zz": {
      "commands": [
        "mkdir -p bin",
        "curl -fsSL https://www.7-zip.org/a/7z2601-linux-x64.tar.xz | tar -xJ -C bin 7zz",
        "chmod +x bin/7zz"
      ]
    }
  },
  "deploy": {
    "aptPackages": [
      "p7zip-full",
      "unrar-free",
      "libarchive-tools"
    ]
  }
}
